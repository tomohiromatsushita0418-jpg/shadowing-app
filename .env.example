GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# Accounts & subscriptions
#
# EXPO_PUBLIC_* values are embedded into the web bundle and are visible to
# anyone — only ever put publishable keys there. The unprefixed ones are read
# by the serverless functions in api/ and must stay server-side.
#
# In Vercel, set every variable below under Project → Settings → Environment
# Variables. See docs/MONETIZATION_SETUP.md for the full walkthrough.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Stripe → Developers → API keys / Webhooks / Products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Public origin of the deployment, no trailing slash.
APP_URL=https://shadowing-app-gray.vercel.app

# Leave unset to enforce nothing. Set to exactly "true" to turn the paywall on.
# Until then accounts work, billing works, and nothing is locked — which is how
# you test the whole flow without shutting existing users out.
EXPO_PUBLIC_PAYWALL_ENABLED=false

# Only needed for the native (Expo Go / store) builds, where there is no
# same-origin to infer. Web leaves this blank.
# EXPO_PUBLIC_API_BASE_URL=https://shadowing-app-gray.vercel.app
